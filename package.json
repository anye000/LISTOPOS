    "@types/pdfmake": "^0.2.13",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
