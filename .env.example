# ─────────────────────────────────────────────────────────────────────
# BASE DE DATOS EN LA NUBE — PostgreSQL (Supabase o Neon o cualquier PG)
#
# La app habla PostgreSQL por protocolo wire: solo cambia la URL. El SSL se
# activa automáticamente para Supabase y Neon.
#
# SUPABASE (Project Settings → Database → Connection string):
#   · Runtime / Vercel (Supavisor TRANSACTION pooler, puerto 6543):
#       DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#   · Migraciones (conexión directa o session pooler, puerto 5432):
#       POSTGRES_URL_NON_POOLING=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
#
# NEON (Dashboard → Connection Details):
#   DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Si se deja vacío → desarrollo local con PGlite (.data/listopos-db).
# ─────────────────────────────────────────────────────────────────────
DATABASE_URL=

# Migraciones (opcional, recomendado en Supabase: conexión directa 5432)
# POSTGRES_URL_NON_POOLING=

# Better Auth
BETTER_AUTH_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# URL pública de la app (para emails, QR de facturas, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
